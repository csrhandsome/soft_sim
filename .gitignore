# Python and tooling
.venv/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.egg-info/
*.log
MUJOCO_LOG.TXT

# Local tooling and secrets are managed outside the project history.
/.agents/
/.aws/
/.codex/
.env
.env.*
!.env.example

# Third-party source snapshots are prepared from pinned revisions.
/.deps/
/third_party/*/

# Input assets that must be downloaded; the reference mesh and material notes stay tracked.
/assets/downloads/
# Searchable TDS text is regenerated from the locally downloaded PDFs.
/assets/materials/*.tds.txt

# Every generated artifact lives under one storage root and stays local.
/artifacts/

# Historical outputs that predate the storage root. Read-only migration input.
/data/generated/
/data/runs/
/data/datasets/
/data/logs/
/data/scene_assets/
/data/backups/
/data/models/
/data/materials/Bambu_TPU_75A-TDS.pdf

# Root-level requested videos and their generated preview metadata stay local.
/*.png
/*.mp4
/*.json
*.pdf
